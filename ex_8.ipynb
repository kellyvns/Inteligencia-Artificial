        "ano = int(input(\"Digite um ano: \"))\n",
        "\n",
        "if (ano % 4 == 0 and ano % 100 != 0) or (ano % 400 == 0):\n",
        "    print(\"Ano bissexto\")\n",
        "    print(\"Fevereiro tem 29 dias\")\n",
        "else:\n",
        "    print(\"Ano não bissexto\")\n",
        "    print(\"Fevereiro tem 28 dias\")"
      ]
