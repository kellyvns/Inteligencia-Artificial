      "source": [
        "usuario = input(\"Digite o usuário: \")\n",
        "senha = input(\"Digite a senha: \")\n",
        "\n",
        "if len(senha) < 8:\n",
        "    print(\"Senha inválida: menos de 8 caracteres\")\n",
        "elif senha == usuario:\n",
        "    print(\"Senha inválida: igual ao usuário\")\n",
        "else:\n",
        "    print(\"Senha válida\")"
      ]
    }
  ]
