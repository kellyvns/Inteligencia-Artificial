      "source": [
        "tempo = int(input(\"Digite o tempo estacionado (em minutos): \"))\n",
        "\n",
        "valor = 5\n",
        "\n",
        "if tempo > 60:\n",
        "    resto = tempo - 60\n",
        "    adicionais = (resto + 29) // 30\n",
        "    valor += adicionais * 2\n",
        "\n",
        "print(f\"Valor a pagar: R${valor:.2f}\")\n"
      ]
    }
  ]
}